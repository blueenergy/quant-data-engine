# quant_data_engine environment configuration
# 
# CONFIGURATION ARCHITECTURE:
# ============================
# .env.example (this file)  │ Template - shows what config values exist
#         ↓ (copy & fill)    │
# .env                       │ Secrets - GITIGNORED, environment-specific values
#         ↓ (read by)      │
# config/settings.py         │ Abstraction - provides typed Settings object
#         ↓ (imported)      │
# All modules             │ via: from quant_data_engine import get_settings()
#
# SETUP:
# 1. Copy this file to .env
# 2. Fill in actual values
# 3. .env is automatically loaded by settings.py at startup
# 4. Access config in code via: settings = get_settings()
#

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB=finance

# Market data database name
DATA_DB_NAME=quant_data

# Realtime snapshot database name
REALTIME_DB_NAME=quant_realtime

# Tushare API token (required for index/stock data ingestion)
# Get your token at: https://tushare.pro
TUSHARE_TOKEN=your_tushare_token_here

# Rate limit for Tushare API (requests per second)
RATE_LIMIT_PER_SEC=4

# International news title translation (best-effort)
# 1=true(enable), 0=false(disable)
INTL_NEWS_TRANSLATE_ENABLED=1
# Target language for translated title
INTL_NEWS_TRANSLATE_TARGET=zh-CN

# Runtime profile:
# domestic = Tushare sync + ladder jobs
# overseas = Yahoo Finance + international news
# full     = all jobs
DEPLOY_MODE=full

# Optional per-task cron overrides for daily_market_sync.sh jobs.
# Format: m h dom mon dow, for example "30 18 * * 1-5".
# CRON_STOCK_DAILY=
# CRON_INDEX_DAILY=
# CRON_ETF_DAILY=
# CRON_FINANCIAL_DAILY=
# CRON_MONEYFLOW_DAILY=
# CRON_SENTIMENT_DAILY=
# CRON_HOTSTOCK_DAILY=
# CRON_REALTIME_DAILY_K=
# CRON_FUND_PORTFOLIO=

# Optional secondary Mongo sync.
# SECONDARY_MONGO_URI=
# SECONDARY_MONGO_DB=finance

# Realtime daily K snapshots and follow-up quantFinance API triggers.
ENABLE_REALTIME_DAILY_K=0
# INTRADAY_T0_TRIGGER_URL=http://quant-api:3001/api/intraday-t0/signals/generate-all
# INTRADAY_T0_TRIGGER_KEY=
# MARKET_INSIGHT_TRIGGER_URL=http://quant-api:3001/api/market-insights/generate-internal
# MARKET_INSIGHT_TRIGGER_KEY=

# X / Twitter API v2 — run_x_influencer_sync（需可访问 api.twitter.com）
# TWITTER_BEARER_TOKEN=
# start.sh 常驻循环默认关闭；有 credits/权限后再设 1
# ENABLE_X_INFLUENCER_SYNC=0
# X_INFLUENCER_USERNAMES=elonmusk,realDonaldTrump,chamath
